#!ipxe
# Example iPXE boot script for netboot.
#
# This file is served when an iPXE client requests the boot script.
# Place it in the VLAN's boot directory (e.g. /data/netboot/trusted/boot.ipxe)
# or in a per-client image directory (e.g. /data/netboot/trusted/ubuntu-22.04/boot.ipxe).

dhcp
echo Booting from gokrazy-router netboot server...

# Kernel and initrd are served from the same directory via HTTP.
kernel vmlinuz initrd=initrd.img console=ttyS0,115200 root=/dev/nfs nfsroot=${next-server}:/srv/nfs ip=dhcp
initrd initrd.img
boot
