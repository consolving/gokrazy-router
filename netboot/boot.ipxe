#!ipxe
# Example iPXE boot script for gokrazy-router.
#
# This TEXT file is served once iPXE has already been loaded. The initial
# legacy PXE ROM must receive the iPXE UNDI binary, usually named
# undionly.kpxe (configured as services.pxe.legacyBootFile or bootFile).
#
# Place this file in the TFTP root (e.g. /mnt/data/tftpboot/boot.ipxe).

dhcp
echo Booting from gokrazy-router netboot server...

# Kernel and initrd are served from the same directory via HTTP.
kernel vmlinuz initrd=initrd.img console=ttyS0,115200 root=/dev/nfs nfsroot=${next-server}:/srv/nfs ip=dhcp
initrd initrd.img
boot
